# ==============================================================================
# Git Ignore Configuration
# ==============================================================================

# --- Secrets & Environment Variables ---
.env
.env.local
.env.*.local
*.env
!.env.example

# --- Specific Research Protocol (Explicitly Ignored) ---
mats_full_research_protocol.md
papers/
    
# --- Virtual Environments ---
venv/
.venv/
env/
ENV/
venv.bak/
env.bak/

# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/
.eggs/

# --- Pyenv / Tooling ---
.python-version

# --- Large Evaluation Logs & Raw Transcripts ---
data/transcripts/*.txt
*.log

# --- Large Binary Papers / Reference PDFs ---
papers/*.pdf

# --- Modal Cloud Artifacts ---
.modal/

# --- IDE & Editor Artifacts ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# --- Operating System Files ---
.DS_Store
Thumbs.db

